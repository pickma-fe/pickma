API_MOCK_ENABLED=true

# 앱 URL (로컬 개발: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Toss Payments
# PAYMENT_MOCK=true 이면 Toss 키 없이 mock 흐름으로 동작 (로컬 개발용)
PAYMENT_MOCK=true

# Toss 대시보드(developers.tosspayments.com)에서 발급한 API 개별 연동 키를 입력할 것
# 테스트: test_ck_... / test_sk_... | 운영: live_ck_... / live_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Upstash Redis (이메일 OTP 인증 상태 저장소)
# https://upstash.com 에서 Redis 데이터베이스 생성 후 REST API 탭에서 확인
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 이메일/IP HMAC hash 생성용 서버 시크릿 (32바이트 이상 랜덤값)
# 생성: node scripts/generate-auth-email-hash-secret.mjs
AUTH_EMAIL_HASH_SECRET=

# Resend (이메일 OTP 발송)
# https://resend.com 에서 API Key 생성 및 도메인 DNS(SPF/DKIM) 설정 후 입력
RESEND_API_KEY=
# Resend에서 인증한 도메인의 발신 주소 (예: noreply@yourdomain.com)
AUTH_EMAIL_FROM=

# 이메일 인증 TTL (초 단위, 기본값 사용 시 공란으로 둬도 됨)
AUTH_EMAIL_OTP_TTL_SECONDS=600
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=1800

# IP rate limit 기준 헤더 (reverse proxy가 실제 클라이언트 IP로 덮어쓰는 헤더)
# Vercel: x-forwarded-for (기본값) | nginx: x-real-ip | Cloudflare: cf-connecting-ip
IP_SOURCE_HEADER=x-forwarded-for

# Vercel Cron
# 생성: openssl rand -hex 32
CRON_SECRET=

# Kakao Maps / Daum Postcode
# https://developers.kakao.com → 내 애플리케이션 → JavaScript 키
# 플랫폼 등록: 앱 설정 → 플랫폼 → Web → 사이트 도메인에 http://localhost:3000 추가
NEXT_PUBLIC_KAKAO_MAPS_APP_KEY=

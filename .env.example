API_MOCK_ENABLED=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Toss Payments
# PAYMENT_MOCK=true 이면 Toss 키 없이 mock 흐름으로 동작 (로컬 개발용)
PAYMENT_MOCK=true

# Toss 대시보드(developers.tosspayments.com)에서 발급한 API 개별 연동 키를 입력할 것
# 테스트: test_ck_... / test_sk_... | 운영: live_ck_... / live_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
